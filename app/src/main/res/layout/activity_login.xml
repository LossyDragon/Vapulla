<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="in.dragonbra.vapulla.activity.LoginActivity">

    <include
        android:id="@+id/loginLogoMiddle"
        layout="@layout/login_logo_middle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/loginErrorText"
        layout="@layout/login_error_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="invisible" />

    <include
        android:id="@+id/loginUsername"
        layout="@layout/login_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="invisible" />

    <include
        android:id="@+id/loginPassword"
        layout="@layout/login_password"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="invisible" />

    <include
        android:id="@+id/loginButton"
        layout="@layout/login_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="invisible" />

    <include
        android:id="@+id/loginLoadingText"
        layout="@layout/login_loading_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="invisible" />

    <include
        android:id="@+id/loginSteamGuard"
        layout="@layout/login_steam_guard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="invisible" />

    <include
        android:id="@+id/loginSteamGuardButton"
        layout="@layout/login_steam_guard_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="invisible" />

    <include
        android:id="@+id/loginSteamGuardCancel"
        layout="@layout/login_steam_guard_cancel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="invisible" />

    <include
        android:id="@+id/loginRetryButton"
        layout="@layout/login_retry_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="invisible" />

</androidx.constraintlayout.widget.ConstraintLayout>
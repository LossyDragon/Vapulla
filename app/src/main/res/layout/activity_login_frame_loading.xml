<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="in.dragonbra.vapulla.activity.LoginActivity">

    <include layout="@layout/login_logo_middle" />

    <include
        android:id="@+id/errorText"
        layout="@layout/login_error_text"
        android:visibility="invisible" />

    <include
        android:id="@+id/loadingText"
        layout="@layout/login_loading_text" />

    <include
        android:id="@+id/usernameLayout"
        layout="@layout/login_username"
        android:visibility="invisible" />

    <include
        android:id="@+id/passwordLayout"
        layout="@layout/login_password"
        android:visibility="invisible" />

    <include
        android:id="@+id/loginButton"
        layout="@layout/login_button"
        android:visibility="invisible" />

    <include
        android:id="@+id/steamGuardLayout"
        layout="@layout/login_steam_guard"
        android:visibility="invisible" />

    <include
        android:id="@+id/steamGuardButton"
        layout="@layout/login_steam_guard_button"
        android:visibility="invisible" />

    <include
        android:id="@+id/cancelButton"
        layout="@layout/login_steam_guard_cancel"
        android:visibility="invisible" />

    <include
        android:id="@+id/retryButton"
        layout="@layout/login_retry_button"
        android:visibility="invisible" />

</androidx.constraintlayout.widget.ConstraintLayout>

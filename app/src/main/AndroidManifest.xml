<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="in.dragonbra.vapulla">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Only used once the user picks a folder of their own to install downloads to, and
         gives the app access to all files on the system screen for it. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".VapullaApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vapulla">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Vapulla"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SteamService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!--
                Not "dataSync": Android stops that type after six hours in a day, and the
                service holds the connection to Steam for as long as the user is signed in.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the connection to Steam open, so chat messages and friend requests arrive while the app is in the background, and runs game downloads." />
        </service>

        <receiver
            android:name=".broadcastreceiver.ReplyReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".broadcastreceiver.LogOutReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".broadcastreceiver.AcceptRequestReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".broadcastreceiver.BlockRequestReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".broadcastreceiver.IgnoreRequestReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>

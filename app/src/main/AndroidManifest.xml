<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Kinda the best FGS type I can see from the docs,
            Vapulla does keep in sync with other clients steam is running on -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />

    <application
        android:name=".VapullaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.Starting"
        tools:ignore="DataExtractionRules">

        <!-- Login -->
        <activity
            android:name=".compose.screens.login.LoginActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home / Main Screen -->
        <activity
            android:name=".compose.screens.home.HomeActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="stateHidden"
            tools:ignore="LockedOrientationActivity" />

        <!-- Chat -->
        <activity
            android:name=".compose.screens.chat.ChatActivity"
            android:launchMode="singleTop"
            android:parentActivityName=".compose.screens.home.HomeActivity"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".compose.screens.home.HomeActivity" />
        </activity>

        <!-- Profile -->
        <activity
            android:name=".compose.screens.profile.ProfileActivity"
            android:launchMode="singleTop"
            android:parentActivityName=".compose.screens.home.HomeActivity"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".compose.screens.home.HomeActivity" />
        </activity>

        <!-- Invites -->
        <activity
            android:name=".compose.screens.invites.InvitesActivity"
            android:launchMode="singleTop"
            android:parentActivityName=".compose.screens.home.HomeActivity"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".compose.screens.home.HomeActivity" />
        </activity>

        <!-- Games Library -->
        <activity
            android:name=".compose.screens.games.GamesActivity"
            android:launchMode="singleTop"
            android:parentActivityName=".compose.screens.profile.ProfileActivity"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".compose.screens.profile.ProfileActivity" />
        </activity>

        <!-- Settings -->
        <activity
            android:name=".compose.screens.settings.SettingsActivity"
            android:exported="true"
            android:parentActivityName=".compose.screens.home.HomeActivity"
            android:theme="@style/AppTheme">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="in.dragonbra.vapulla.compose.screens.home.HomeActivity" />

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="authorize"
                    android:scheme="vapulla" />
            </intent-filter>
        </activity>

        <!-- Steam Service -->
        <service
            android:name=".service.SteamService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- Receivers -->
        <receiver android:name=".broadcastreceiver.ReplyReceiver" />

        <receiver android:name=".broadcastreceiver.AcceptRequestReceiver" />

        <receiver android:name=".broadcastreceiver.BlockRequestReceiver" />

        <receiver android:name=".broadcastreceiver.IgnoreRequestReceiver" />
    </application>

</manifest>
